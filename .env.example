GOOGLE_CLOUD_PROJECT=hack2skill-510921
FIRESTORE_DATABASE=asapify
ASAPIFY_VERSION=operator-v1
TELEGRAM_ENABLED=false
# Optional cross-origin development only. Production uses the Firebase Hosting rewrite.
CORS_ORIGINS=http://localhost:5173
# Set TELEGRAM_BOT_TOKEN through Secret Manager on Cloud Run, never commit it.

# Notification Engine v1. dry_run never contacts messaging providers.
NOTIFICATION_MODE=dry_run
FCM_ENABLED=false
ASAPIFY_PUBLIC_ORIGIN=
NOTIFICATION_WORKER_URL=
NOTIFICATION_TASK_CALLER=
NOTIFICATION_TASK_QUEUE=asapify-notifications
NOTIFICATION_TASK_REGION=asia-southeast2
TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN: Secret Manager; worker only.
# TELEGRAM_WEBHOOK_SECRET: Secret Manager; API only. Set identical Telegram webhook secret_token.
